# ==============================================================================
# PROJECT EMAS - MODUL RAG PUSDIKZI ENVIRONMENT CONFIGURATION
# Sesuai PRD Arsitektur Air-Gapped & Intel Core Ultra 125H
# ==============================================================================

# ChromaDB Vector Database Settings
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=pusdikzi_knowledge_base
CHROMA_PERSISTENCE=TRUE

# Embedding Settings (Local On-Premise)
# Default menggunakan Nomic Embed Text v1.5 atau local model path
EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Ingestion & Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed

# Intel Core Ultra 125H & IPEX-LLM Optimization Flags
SYCL_PI_LEVEL_ZERO_USE_IMMEDIATE_COMMANDLISTS=1
OLLAMA_NUM_PARALLEL=1
SHARED_VRAM_LIMIT_GB=4.5

# Security & RBAC Defaults
DEFAULT_SECURITY_CLASSIFICATION=INTERNAL

